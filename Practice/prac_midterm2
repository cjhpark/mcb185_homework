PDF = [.1, .2, .3, .4]
def entropy(pdf):
	sum = 0
	entropy = 0
	for p in pdf: sum += p
	if not math.isclose(sum, 1): sys.exit('error?')
	for i in range(len(pdf)):
		entropy += pdf[i]*math.log(pdf[i])
	return -1 * entropy

print(entropy(PDF))
