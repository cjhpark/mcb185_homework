def dkl(P, Q):
	sum = 0
	print(type(P))
	for pair in zip(P, Q):
		if type(pair[0]) == str or type(pair[1]) == str: sys.exit('Not Compatibile')
		if type(pair[0]) == None or type(pair[1]) == None: sys.exit('Not Compatible') 
		if pair[0] == 0 or pair[1] == 0: sum += 0
		else: sum += pair[0]*math.log10(pair[0]/pair[1])
	return sum

