# 45 PolyAAA Function
def polya(dna):
	longest_a = 0
	for i in range(len(dna)):
		if dna[i] == 'A': 
			current_a = 1
			for j in range(1, len(dna) - i):
				if dna[i+j] == 'A': current_a += 1
				if current_a > longest_a: longest_a = current_a
				if dna[i+j] != 'A': break
	return longest_a

