# 49 Entropy Masking
def entropy(abc):
	pa = abc.count('A')/len(abc)
	pc = abc.count('C')/len(abc)
	pg = abc.count('G')/len(abc)
	pt = abc.count('T')/len(abc)
	h = 0
	if pa != 0: h -= pa*math.log2(pa)
	if pc != 0: h -= pc*math.log2(pc)
	if pg != 0: h -= pg*math.log2(pg)
	if pt != 0: h -= pt*math.log(pt)
	return h

