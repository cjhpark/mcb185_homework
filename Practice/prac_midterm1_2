# 15 Factorial
def factorial(n):
	fact = 1
	if n == 0:	
		return fact
	for i in range(n):
		fact *= (n-i)	
	return fact

#16 Prime Booleans		
def is_prime(n):
	if n % 1 != 0 or n <0:		sys.exit('Not a valid number.')
	if n == 0 or n == 1:		return False 
	if n == 2:			return True
	elif n % 2 == 0:		return False
	for i in range(3, n, 2):
		if n % i == 0:		return False
	else:				return True 

