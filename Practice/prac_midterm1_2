# 8 Nucleotide Complememnt
def complement(nt):
	nts = ['A', 'C', 'G', 'T']
	comps =	['T', 'G', 'C', 'A']
	if nt not in nts:
		return 'Not a Nucleotide'
	idx = nts.index(nt)
	return comps[idx]

